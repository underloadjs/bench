# ============================================================================
# .gitignore - build artifacts, dependency and cache dirs never get pushed
# ============================================================================

# Dependencies
node_modules/

# Build output (vite build emits to the package-level dist/)
dist/

# Turbo cache
.turbo/

# Tooling caches
.eslintcache
*.tsbuildinfo

# Test coverage
coverage/

# Dev certificates (mkcert output - keys must never be committed)
certs/

# Package-manager logs
yarn-debug.log*
yarn-error.log*
npm-debug.log*

# Local env / secrets
.env
.env.*

# OS junk
.DS_Store
Thumbs.db

# Editor state
.idea/
.vscode/
